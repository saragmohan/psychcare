# ==========================================
# PSYCHCARE REAL EMAIL CONFIGURATION
# ==========================================
#
# Option 1: Resend (Recommended - 3,000 free emails/month)
# Sign up at https://resend.com and paste your API key below:
VITE_RESEND_API_KEY=
# RESEND_FROM="PsychCare Security <onboarding@resend.dev>"

# Option 2: Gmail SMTP (Send directly from your Gmail account)
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
